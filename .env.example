# Variables de Stock Core para Docker.
# Copia este archivo a .env (es el único paso previo):   Copy-Item .env.example .env    (o: cp .env.example .env)
# .env está en .gitignore: tus valores reales NUNCA se suben al repositorio.

# Contraseña del usuario «sa» de SQL Server (8+ caracteres con mayúsculas, minúsculas y números; sin ; ni $)
MSSQL_SA_PASSWORD=StockCore2026Sql

# Dirección donde responde la API (con ella se arman los enlaces de los correos)
APP_BASE_URL=http://localhost:5001

# Primer Administrador (se crea al arrancar si no existe)
ADMIN_EMAIL=admin@stockcore.com
ADMIN_PASSWORD=Admin1234

# Correo: «consola» escribe cada correo en el log del enviador (docker compose logs enviador);
# «smtp» los envía de verdad con las variables SMTP_* (por ejemplo, Gmail con una contraseña de aplicación).
CORREO_MODO=consola
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-contrasena-de-aplicacion
SMTP_FROM=tu-correo@gmail.com
SMTP_SSL=true

# API externa de tasas de cambio (https://www.exchangerate-api.com). Pon aquí tu clave gratuita.
# Con este valor de ejemplo, la cotización responde 503 con un mensaje claro y el resto del sistema funciona.
EXCHANGE_API_KEY=tu-clave-de-exchangerate-api

# Opcionales
ACTIVACION_MINUTOS=1440
RECUPERACION_MINUTOS=30
SESION_HORAS=8
DOCUMENTOS_MAX_MB=10
